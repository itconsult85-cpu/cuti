# ============================================================
# CONTOH KONFIGURASI — salin ke file .env sebelum menjalankan:
#   cp .env.example .env
# lalu edit nilainya. File .env asli TIDAK di-push ke GitHub
# karena berisi rahasia (password).
# ============================================================

# Port dashboard web (default 3000; ubah jika port terpakai)
PORT=3000

# Password login dashboard. Username tetap: admin.
# Kosongkan nilai ini (DASHBOARD_PASSWORD=) jika ingin dashboard
# tidak terkunci untuk pemakaian lokal, lalu ganti lewat panel
# "Keamanan Dashboard" pada tab Ringkasan.
DASHBOARD_PASSWORD=ubahDenganPasswordKuatMinimal6Karakter

# Lokasi file database SQLite (opsional; default data/hotline.db)
# DB_PATH=./data/hotline.db
